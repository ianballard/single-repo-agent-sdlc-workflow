{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "Skill(manage-backlog-tasks)",
      "Skill(workflow)",
      "Skill(check-for-work)",
      "Skill(unit-tests)",
      "Skill(e2e-tests)",
      "Skill(implementation-notes)",
      "Skill(code-review)",
      "Skill(commit)",
      "Skill(audit-followed-workflow-steps)",
      "Bash(backlog task:*)",
      "Bash(git init:*)",
      "Bash(git checkout:*)",
      "Bash(pip install:*)",
      "Bash(pytest:*)",
      "Bash(python -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm create:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(git merge:*)",
      "Bash(git show-ref:*)",
      "Bash(npx playwright:*)",
      "Bash(dir:*)"
    ],
    "ask": [
      "Bash(aws:*)",
      "Edit(CLAUDE.md)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/skills/**)",
      "Edit(**/.claude/hooks/**)",
      "Edit(**/.claude/agents/**)",
      "Edit(**/.claude/commands/**)",
      "Bash(git worktree remove*)",
      "Bash(git commit --amend*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws * create-*)",
      "Bash(aws * delete-*)",
      "Bash(aws * put-*)",
      "Bash(aws * update-*)",
      "Bash(aws * modify-*)",
      "Bash(aws * remove-*)",
      "Bash(aws * revoke-*)",
      "Bash(aws * attach-*)",
      "Bash(aws * detach-*)",
      "Bash(aws * run-*)",
      "Bash(aws * start-*)",
      "Bash(aws * stop-*)",
      "Bash(aws * reboot-*)",
      "Bash(aws * terminate-*)",
      "Bash(aws * restore-*)",
      "Bash(aws * associate-*)",
      "Bash(aws * disassociate-*)",
      "Bash(aws * authorize-*)",
      "Bash(aws * register-*)",
      "Bash(aws * deregister-*)",
      "Bash(aws * enable-*)",
      "Bash(aws * disable-*)",
      "Bash(aws * add-*)",
      "Bash(aws * set-*)",
      "Bash(aws * tag-*)",
      "Bash(aws * untag-*)",
      "Bash(aws * reset-*)",
      "Bash(aws * cancel-*)",
      "Bash(aws * purge-*)",
      "Bash(aws * schedule-*)",
      "Bash(aws * invoke-*)",
      "Bash(aws * publish-*)",
      "Bash(aws * send-*)",
      "Bash(aws * execute-*)",
      "Bash(aws * assume-*)",
      "Bash(aws * copy-*)",
      "Bash(aws * import-*)",
      "Bash(aws * replace-*)",
      "Bash(aws * batch-*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 mv:*)",
      "Bash(aws s3 sync:*)",
      "Bash(aws s3 cp:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws configure:*)",
      "Bash(cdk deploy*)",
      "Bash(cdk destroy*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin staging*)",
      "Bash(git push -u origin main*)",
      "Bash(git push -u origin master*)",
      "Bash(git push -u origin develop*)",
      "Bash(git push -u origin staging*)",
      "Bash(rm -rf /*)",
      "Read(.env)",
      "Edit(.env)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(**/.claude/*.local.json)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git reflog expire*)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref -d*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(git remote remove*)",
      "Bash(git config --global*)",
      "Bash(git config --unset*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config credential.helper*)",
      "Bash(git config alias.*)",
      "Bash(git submodule add*)",
      "Bash(git submodule update --remote*)",
      "Bash(git push --delete*)",
      "Bash(git push --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push origin :*)",
      "Bash(git push --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh secret set*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-attempt-log.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-file-access.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-in-write.sh\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-attempt-log.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-file-access.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-in-command.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-destructive-git.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-git-remote-tamper.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-gh-dangerous.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-exfiltration.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-command-log.sh\"" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/audit-file-change-log.sh\"" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "deploy-on-aws@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  }
}
